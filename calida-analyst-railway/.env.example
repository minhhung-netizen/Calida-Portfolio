# ===== Pipeline (Python) =====
GOOGLE_SA_FILE=secrets/service-account.json   # service account có quyền xem 2 Google Sheet
PORTFOLIO_SHEET_ID=                            # ID Google Sheet Portfolio Automation
FUNDS_SHEET_ID=1CSLovnkwLaF6DHGA7Lkv4MQBIgtFJ4dMzi2M2-nWSDs
PRICE_LOOKBACK_DAYS=400
VNSTOCK_SOURCE=VCI
FUND_UNIVERSE_TOTAL=0          # tổng số quỹ theo dõi; 0 = tự đếm
WEIGHTS_AS_FRACTION=auto       # auto | true (sheet lưu 0.12) | false (sheet lưu 12)
NAV_DIVISOR=1                  # 1e9 nếu NAV trong sheet tính theo đồng

# ===== Server (Node) =====
PORT=8080
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ACCESS_TOKEN=                  # đặt để bắt buộc nhập mã khi hỏi đáp / lưu báo cáo
PYTHON_BIN=python              # Windows: python ; Linux/Mac: python3
PIPELINE_TIME=16:30            # giờ chạy pipeline hằng ngày (T2–T6); để trống để tắt
