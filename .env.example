# ===== Pipeline (Python) =====
GOOGLE_SA_FILE=secrets/service-account.json   # service account có quyền xem 2 Google Sheet
PORTFOLIO_SHEET_ID=                            # ID Google Sheet Portfolio Automation
FUNDS_SHEET_ID=                            # ID Google Sheet Fmarket DB
OPERATIONS_SHEET_ID=                         # ID Google Sheet Vận hành dữ liệu: VIEW/NEWS/EVENTS/FLOW/SUMMARY
REPORTS_SHEET_ID=                            # ID Google Sheet Báo cáo CTCK
PRICE_LOOKBACK_DAYS=400
VNSTOCK_SOURCE=VCI
FUND_UNIVERSE_TOTAL=0          # tổng số quỹ theo dõi; 0 = tự đếm
WEIGHTS_AS_FRACTION=auto       # auto | true (sheet lưu 0.12) | false (sheet lưu 12)
NAV_DIVISOR=1                  # 1e9 nếu NAV trong sheet tính theo đồng

# ===== Server (Node) =====
PORT=8080
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ACCESS_TOKEN=                  # mật khẩu chung dự phòng cho một tài khoản admin
SESSION_SECRET=                # chuỗi ngẫu nhiên dài, riêng với ACCESS_TOKEN
# Tài khoản khởi tạo (admin có thể tạo/sửa/xóa user và quyền theo module sau khi đăng nhập)
# Ví dụ: [{"username":"admin","password":"mat-khau-ban-dau","role":"admin"}]
# Có thể đặt quyền riêng: "permissions":{"reports":{"view":true,"edit":true},"portfolio":{"view":false,"edit":false}}
# Module: overview, brief, portfolio, flows, funds, reports, actions, signals, admin. Chỉ role admin được cấp module admin.
# CALIDA_USERS_JSON=
SESSION_TTL_HOURS=8            # 1–168 giờ
SESSION_COOKIE_SECURE=auto     # auto | true | false; auto dùng Secure khi production/HTTPS
# Web Push/PWA: tạo một lần bằng "cd server && npm run generate:vapid". Không thay cặp key sau khi đã có người đăng ký.
VAPID_SUBJECT=mailto:ops@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
MAX_UPLOAD_MB=20
GEMINI_TIMEOUT_MS=60000
PIPELINE_TIMEOUT_MS=1200000
PYTHON_BIN=python              # Windows: python ; Linux/Mac: python3
PIPELINE_TIME=16:30            # giờ chạy pipeline hằng ngày (T2–T6); để trống để tắt
# Railway: false để khởi động web không phụ thuộc nguồn dữ liệu ngoài; chỉ bật true cho một lần rebuild có chủ đích
REBUILD_ON_BOOT=false
